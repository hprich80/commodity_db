# Required application credentials
POSTGRES_PASSWORD=change-me-to-a-strong-password
API_KEY=your-fred-api-key
FERNET_KEY=generate-with-python3-cryptography-fernet-command

# Optional Airflow UI credentials (defaults are airflow / airflow)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
 
# Linux user ID used by Airflow containers for file ownership on mounted volumes.
AIRFLOW_UID=5000
